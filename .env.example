# 复制为 .env 后填写。不要提交包含真实密钥的 .env。
CANVAS_REGISTRATION_ENABLED=false
CANVAS_ALLOW_PRIVATE_UPSTREAMS=false
CANVAS_ALLOWED_PRIVATE_UPSTREAM_HOSTS=
CANVAS_WORKER_CONCURRENCY=3
CANVAS_CHANNEL_CONCURRENCY=3
CANVAS_ENVIRONMENT=development
CANVAS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 图片 Prompt Specialist 默认关闭；本地联调时必须同时配置下列完整契约。
CANVAS_IMAGE_PROMPT_SPECIALIST_ENABLED=false
CANVAS_IMAGE_PROMPT_SPECIALIST_URL=
CANVAS_IMAGE_PROMPT_HMAC_SERVICE_ID=
CANVAS_IMAGE_PROMPT_HMAC_SECRET=
CANVAS_IMAGE_PROMPT_TIMEOUT_MS=
# Hono 回调以下私有模型中继时使用；必须与上面的正向 HMAC 密钥不同，并要求 REDIS_URL 可用。
CANVAS_IMAGE_PROMPT_RELAY_ALLOWED_SERVICE_ID=hono-image-prompt
CANVAS_IMAGE_PROMPT_RELAY_HMAC_SECRET=
# 仅 development 可用；普通模型渠道和筷子托管渠道共用同一受校验的本机 HTTP 出站代理。
CANVAS_DEVELOPMENT_PROXY_URL=http://host.docker.internal:7897

# 本地 Docker 数据目录必须显式指定绝对路径。日常启动请使用
# `powershell -ExecutionPolicy Bypass -File scripts/local-compose.ps1`，脚本会固定到
# Git 主项目唯一的 `.local/data`，即使从 worktree 启动也不会创建第二份数据库。
CANVAS_DATA_PATH=

# 生产环境请改用 `.env.production.example`，本文件只服务本地开发。
