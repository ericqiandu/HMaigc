# HMaigc 生产部署配置。复制为 .env.production，权限设为 600，禁止提交真实值。

# 仅允许不可变发布标签，例如 v1.0.13；禁止使用 latest。
HMAIGC_IMAGE_REGISTRY=ghcr.io/你的GitHub用户名
HMAIGC_VERSION=v1.0.13
HMAIGC_COMPOSE_PROJECT_NAME=hmaigc

# 独立运维控制器使用自己的镜像版本和 Compose 生命周期，不随业务后端停止。
HMAIGC_OPS_VERSION=v1.0.13
HMAIGC_OPS_COMPOSE_PROJECT_NAME=hmaigc-ops
HMAIGC_OPS_STATE_VOLUME=hmaigc-ops-state
HMAIGC_OPS_STATE_DIR=/var/lib/hmaigc-ops
# 后端镜像固定的 app 组 GID；用于只读访问控制器 socket 与共享密钥。
HMAIGC_BACKEND_GID=101

# 私有 GitHub 仓库需要 fine-grained 只读 Token 才能检查最新 Release。
HMAIGC_RELEASES_API_URL=https://api.github.com/repos/你的GitHub用户名/你的仓库/releases/latest
HMAIGC_RELEASES_API_TOKEN=

# 固定卷名是备份、恢复和回滚契约的一部分，生产启用后不得随意修改。
HMAIGC_BACKEND_DATA_VOLUME=hmaigc-backend-data
HMAIGC_POSTGRES_DATA_VOLUME=hmaigc-postgres-data
HMAIGC_REDIS_DATA_VOLUME=hmaigc-redis-data

POSTGRES_DB=hmaigc
POSTGRES_USER=hmaigc
POSTGRES_PASSWORD=请使用_openssl_rand_hex_32_生成

CANVAS_CORS_ORIGINS=https://你的域名
CANVAS_HTTP_HOST=127.0.0.1
CANVAS_HTTP_PORT=3000
CANVAS_REGISTRATION_ENABLED=false
CANVAS_ALLOW_PRIVATE_UPSTREAMS=false
CANVAS_ALLOWED_PRIVATE_UPSTREAM_HOSTS=
CANVAS_WORKER_CONCURRENCY=3
CANVAS_CHANNEL_CONCURRENCY=3

# 控制器容器内的部署状态与备份路径，均持久化在独立 ops-state 卷。
HMAIGC_STATE_DIR=/var/lib/hmaigc-ops/release
HMAIGC_BACKUP_DIR=/var/lib/hmaigc-ops/backups
# 0 表示不自动删除；设置正整数即明确授权仅保留最近 N 个恢复点。
HMAIGC_BACKUP_RETENTION=0
