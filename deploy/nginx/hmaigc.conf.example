map $http_upgrade $hmaigc_connection_upgrade {
    default upgrade;
    "" close;
}

map $status $hmaigc_proxy_failure {
    ~^[45] 1;
    default 0;
}

log_format hmaigc_no_query '$remote_addr - $remote_user [$time_local] '
                           '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                           '"$http_user_agent"';
log_format hmaigc_proxy_error 'proxy_failure time=$time_iso8601 client=$remote_addr '
                              'method=$request_method uri=$uri status=$status '
                              'upstream_status=$upstream_status';

server {
    listen 80;
    listen [::]:80;
    server_name aigc.example.com;
    access_log /var/log/nginx/access.log hmaigc_no_query;

    # Bearer capability URIs are excluded from URI-bearing proxy logs even on redirects.
    location ^~ /api/payments/checkout/ {
        access_log off;
        error_log /dev/null crit;
        add_header Cache-Control "private, no-store" always;
        add_header Pragma "no-cache" always;
        add_header Referrer-Policy "no-referrer" always;
        return 308 https://$server_name$request_uri;
    }

    location ^~ /pay/ {
        access_log off;
        error_log /dev/null crit;
        add_header Cache-Control "private, no-store" always;
        add_header Pragma "no-cache" always;
        add_header Referrer-Policy "no-referrer" always;
        return 308 https://$server_name$request_uri;
    }

    location / {
        return 308 https://$server_name$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name aigc.example.com;
    access_log /var/log/nginx/access.log hmaigc_no_query;

    ssl_certificate /etc/letsencrypt/live/aigc.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aigc.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1024m;

    location ^~ /api/payments/checkout/ {
        access_log off;
        error_log /dev/null crit;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Referer "";
        proxy_hide_header Cache-Control;
        proxy_hide_header Pragma;
        proxy_hide_header Referrer-Policy;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        add_header Cache-Control "private, no-store" always;
        add_header Pragma "no-cache" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    location ^~ /pay/ {
        access_log off;
        error_log /dev/null crit;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Referer "";
        proxy_hide_header Cache-Control;
        proxy_hide_header Pragma;
        proxy_hide_header Referrer-Policy;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        add_header Cache-Control "private, no-store" always;
        add_header Pragma "no-cache" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    location / {
        access_log /var/log/nginx/access.log hmaigc_no_query;
        access_log /var/log/nginx/error.log hmaigc_proxy_error if=$hmaigc_proxy_failure;
        error_log /dev/null crit;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Referer "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hmaigc_connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
