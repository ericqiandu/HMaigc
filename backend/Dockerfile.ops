# syntax=docker/dockerfile:1.7

FROM golang:1.25-alpine AS ops-build

ARG GOPROXY=https://proxy.golang.org,direct
ARG APP_VERSION=dev
ARG APP_COMMIT=unknown
ENV GOPROXY=$GOPROXY

RUN apk add --no-cache build-base

WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY backend ./
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=1 GOOS=linux go build -trimpath \
        -ldflags="-s -w -X infinite-canvas/backend/internal/buildinfo.Version=${APP_VERSION} -X infinite-canvas/backend/internal/buildinfo.Commit=${APP_COMMIT}" \
        -o /out/hmaigc-ops-controller ./cmd/ops-controller \
    && CGO_ENABLED=1 GOOS=linux go build -trimpath \
        -o /out/hmaigc-opsctl ./cmd/opsctl

FROM alpine:3.22

RUN apk add --no-cache \
        bash \
        ca-certificates \
        coreutils \
        curl \
        docker-cli \
        docker-cli-compose \
        grep \
        sed \
        tar \
        util-linux \
    && mkdir -p /opt/hmaigc /var/lib/hmaigc-ops \
    && chmod 0750 /var/lib/hmaigc-ops

WORKDIR /opt/hmaigc
COPY docker-compose.production.yml /opt/hmaigc/docker-compose.production.yml
COPY deploy /opt/hmaigc/deploy
COPY --from=ops-build /out/hmaigc-ops-controller /usr/local/bin/hmaigc-ops-controller
COPY --from=ops-build /out/hmaigc-opsctl /usr/local/bin/hmaigc-opsctl

ENV HMAIGC_OPS_STATE_DIR=/var/lib/hmaigc-ops
ENV HMAIGC_OPS_SOCKET=/var/lib/hmaigc-ops/controller.sock
ENV HMAIGC_OPS_SHARED_SECRET_FILE=/var/lib/hmaigc-ops/shared-secret
ENV HMAIGC_RELEASE_STATE_FILE=/var/lib/hmaigc-ops/release/release.env
ENV HMAIGC_STATE_DIR=/var/lib/hmaigc-ops/release
ENV HMAIGC_BACKUP_DIR=/var/lib/hmaigc-ops/backups
ENV HMAIGC_DEPLOY_SCRIPT=/opt/hmaigc/deploy/hmaigc.sh
ENV HMAIGC_ENV_FILE=/opt/hmaigc/.env.production

VOLUME ["/var/lib/hmaigc-ops"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD hmaigc-opsctl status >/dev/null || exit 1
CMD ["hmaigc-ops-controller"]
